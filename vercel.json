{
  "headers": [
    {
      "source": "/mini.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/mini-host-preview.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "buildCommand": "node --test tests/securepay-mini-trader-cohort.test.mjs && node --test tests/securepay-mini-phase1.test.mjs && node --test tests/securepay-mini-phase2.test.mjs && npm run typecheck && npm run build"
}
