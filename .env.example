# Real is the default. No credentials belong in Vite environment variables.
VITE_SECUREPAY_MODE=real
VITE_SECUREPAY_API_BASE_URL=https://your-securepay-api.example
# For local Bolt visual acceptance only: VITE_SECUREPAY_MODE=fixture
# Production builds reject fixture mode, including #/demo routes.

# M5 quotation→Agreement UI is disabled until the isolated API+Mini build
# has been deployed and specifically opted in. NEVER treat this as Money GO.
VITE_SECUREPAY_M5_QUOTATIONS=disabled

# Canonical Agreement Money GET is exposed only with a separately deployed
# matching ISOLATED SecurePayAPI. No payment intent, provider or release.
VITE_SECUREPAY_M6_MONEY_STATUS=disabled
